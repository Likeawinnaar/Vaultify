NODE_ENV=development
# Local/self-hosted encryption key. Run `npm run setup:env` to generate it in the ignored .env file.
# Never commit the real value or expose it with NEXT_PUBLIC_.
VAULTIFY_MASTER_KEY=

# Local/self-hosted storage. Ignored by Vercel when private Blob storage is configured.
VAULTIFY_DATA_DIR=./data

# Vercel / serverless database. Create/connect a Turso (libSQL) database and copy its credentials here.
# Local self-hosted installs do not need these values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel private Blob storage. Creating a private Blob store in the Vercel project adds this automatically.
BLOB_READ_WRITE_TOKEN=

VAULTIFY_SESSION_DAYS=30
VAULTIFY_RATE_LIMIT_PER_MINUTE=60
